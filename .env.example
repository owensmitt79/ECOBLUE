# EcoBlue Private Server-Side Database Configuration Template
# Duplicate this file as .env.local and populate with your credentials.
# Do NOT prefix with NEXT_PUBLIC_ to keep credentials strictly server-side.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-service-key-here

# Staff Admin Portal Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-strong-password-here
ADMIN_SESSION_SECRET=generate-a-64-character-hex-secret-here

